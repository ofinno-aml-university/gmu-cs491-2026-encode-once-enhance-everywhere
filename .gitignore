# Video files, model files, and outputs never go in Git (Developer Standards)
*.mp4
*.mkv
*.mov
*.y4m
*.yuv
*.onnx
output/
outputs/

# temp/ keeps its folder but ignores everything inside it
temp/*
!temp/.gitkeep

# Secrets
.env
*.key
*.pem
secrets*

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# JavaScript
node_modules/

# Editors and OS
.vscode/
.idea/
.DS_Store